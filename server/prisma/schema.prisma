generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite không hỗ trợ enum — dùng String + validate ở tầng ứng dụng (shared/types).
model Card {
  id          String    @id
  name        String
  slug        String    @unique
  description String
  type        String
  rarity      String
  manaCost    Int
  attack      Int
  health      Int
  heroClass   String
  imagePath   String
  effects     Json
  keywords    Json
  collectible Boolean   @default(true)
  cardSet     String    @default("coincard-base")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  deckCards DeckCard[]
}

model Deck {
  id         String    @id
  playerId   String
  name       String
  size       Int       @default(30)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  player     Player    @relation(fields: [playerId], references: [id])
  deckCards  DeckCard[]
  gamePlayers GamePlayer[]

  @@index([playerId])
}

model DeckCard {
  id        String   @id
  deckId    String
  cardId    String
  quantity  Int      @default(1)

  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([deckId, cardId])
  @@index([cardId])
}

model Player {
  id          String     @id
  name        String
  createdAt   DateTime   @default(now())

  decks       Deck[]
  games       GamePlayer[]
  actions     GameAction[]
}

model Hero {
  id          String @id
  name        String
  heroClass   String @unique
  powerName   String
  powerCost   Int
  imagePath   String
}

// GameStatus dùng string: WAITING | MULLIGAN | PLAYING | FINISHED
model Game {
  id          String     @id
  roomCode    String
  status      String     @default("WAITING")
  startedAt   DateTime   @default(now())
  finishedAt  DateTime?
  winnerId    String?

  players     GamePlayer[]
  history     GameHistory[]
  actions     GameAction[]

  @@index([roomCode])
}

model GamePlayer {
  id        String  @id
  gameId    String
  playerId  String
  deckId    String?
  winner    Boolean @default(false)

  game      Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player    Player  @relation(fields: [playerId], references: [id])
  deck      Deck?   @relation(fields: [deckId], references: [id])

  @@unique([gameId, playerId])
  @@index([playerId])
  @@index([deckId])
}

model GameHistory {
  id        String   @id
  gameId    String
  turn      Int
  action    String
  payload   String
  createdAt DateTime @default(now())

  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, turn])
}

model GameAction {
  id        String   @id
  gameId    String
  playerId  String
  action    String
  payload   String
  turn      Int
  createdAt DateTime @default(now())

  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id])

  @@index([gameId, turn])
  @@index([playerId])
}
