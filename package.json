{
  "name": "coincard",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run build:shared && concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build:shared": "npm run build --workspace shared",
    "build:server": "npm run build --workspace server",
    "build:client": "npm run build --workspace client",
    "build": "npm run build:shared && npm run typecheck --workspace client && npm run build:server && npm run build:client",
    "verify": "npm run build && npm test && npm run test:integration",
    "test:integration": "node scripts/integration.mjs",
    "start": "npm run start --workspace server",
    "tunnel": "node scripts/tunnel.mjs",
    "build:java": ".\\.tools\\apache-maven-3.9.9\\bin\\mvn.cmd -f server-java/pom.xml package -DskipTests",
    "test:java": ".\\.tools\\apache-maven-3.9.9\\bin\\mvn.cmd -f server-java/pom.xml test",
    "dev:java": ".\\.tools\\apache-maven-3.9.9\\bin\\mvn.cmd -f server-java/pom.xml spring-boot:run",
    "start:java": "java -jar server-java/target/coincard-server-0.0.1.jar",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "dev:lan": "npm run build:shared && concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "prisma:generate": "npm run prisma:generate --workspace server",
    "prisma:migrate": "npm run prisma:migrate --workspace server",
    "prisma:push": "npm run prisma:push --workspace server",
    "seed": "npm run seed --workspace server",
    "test": "npm run test --workspace server",
    "test:e2e": "node e2e-two-players.cjs",
    "test:e2e-neg": "node e2e-negative.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
